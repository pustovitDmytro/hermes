{
  "name": "hermes",
  "version": "1.0.3",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start:sample": "http-server tests/sample -p 3001",
    "start:build": "http-server build -p 3002",
    "start:firefox": "web-ext run --source-dir build/firefox --verbose --start-url http://localhost:3001",
    "build:firefox": "webpack --config webpack.config.js && web-ext build --source-dir build/firefox --verbose --artifacts-dir build -o",
    "firefox": "concurrently --kill-others \"webpack --config webpack.config.js --watch\" \"npm run start:firefox\" \"npm run start:sample\"",
    "prepare": "husky install",
    "coveralls": "cat ./reports/coverage/lcov.info | coveralls",
    "lint:js": "eslint src bin tests --no-error-on-unmatched-pattern",
    "lint:firefox": "web-ext lint --source-dir build/firefox --verbose",
    "test:security": "npm audit --production && npm run test:lock",
    "test:mocha": "mocha --config .mocharc.json 'tests/**/*test.js'",
    "test:lint": "npm run lint:js && npm run lint:firefox",
    "test:package": "npt test -c .package-tester.json",
    "test:coverage": "nyc mocha --config .mocharc.json 'tests/**/*test.js'",
    "test:debt": "jscpd src --config .jscpd.json",
    "test:lock": "lockfile-lint --path package-lock.json --validate-https --allowed-hosts npm",
    "coverage-check": "MODE=test nyc check-coverage",
    "test": "npm run test:lint && npm run test:security && npm run test:mocha",
    "semantic-release": "npx semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pustovitDmytro/hermes.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pustovitDmytro/hermes/issues"
  },
  "homepage": "https://github.com/pustovitDmytro/hermes#readme",
  "engines": {
    "node": ">=10"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/node": "^8.0.1",
    "@babel/plugin-proposal-class-properties": "^7.17.12",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-proposal-object-rest-spread": "^7.18.0",
    "@babel/plugin-proposal-optional-chaining": "^7.17.12",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/runtime": "^8.0.0",
    "@google/semantic-release-replace-plugin": "^1.1.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "babel-loader": "^10.1.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "chai": "^6.2.2",
    "cls-hooked": "^4.2.2",
    "concurrently": "^10.0.5",
    "conventional-changelog-eslint": "^6.1.0",
    "copy-webpack-plugin": "^14.0.0",
    "coveralls": "^3.1.1",
    "css-loader": "^7.1.5",
    "danger": "^14.0.7",
    "docopt": "^0.6.2",
    "eslint": "^10.9.1",
    "eslint-config-incredible": "^2.3.4",
    "eslint-loader": "^4.0.2",
    "eslint-plugin-censor": "^1.5.1",
    "eslint-plugin-import": "^2.24.2",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-mocha": "^12.0.2",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-scanjs-rules": "^0.2.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "fs-extra": "^11.4.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jscpd": "^5.1.1",
    "json-query": "^2.2.2",
    "lockfile-lint": "^5.0.1",
    "mocha": "^12.0.0",
    "mocha-junit-reporter": "^2.0.2",
    "nyc": "^18.0.0",
    "sass": "^1.53.0",
    "sass-loader": "^17.0.1",
    "semantic-release": "^25.0.9",
    "semantic-release-telegram": "^1.0.5",
    "style-loader": "^4.0.0",
    "underscore-template-loader": "^1.1.0",
    "web-ext": "^10.6.0",
    "webpack": "^5.70.0",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "base-api-client": "1.5.9",
    "myrmidon": "1.7.2",
    "uuid": "8.3.2"
  }
}
